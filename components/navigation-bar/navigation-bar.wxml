<view class="weui-navigation-bar {{extClass}}">
  <view class="weui-navigation-bar__placeholder {{ios ? 'ios' : 'android'}}" style="padding-top:{{statusBarHeight}}px;visibility: hidden;"></view>
  <view class="weui-navigation-bar__inner {{ios ? 'ios' : 'android'}}" style="color:{{color}};background:{{background}};{{displayStyle}};padding-top:{{statusBarHeight}}px;">

    <!-- 左侧：back 为 true 显示返回箭头（点击 navigateBack 并派发 back 事件）；
         为 false 显示 left slot（不传 slot 就是纯空白） -->
    <view class="weui-navigation-bar__left">
      <block wx:if="{{back}}">
        <view class="weui-navigation-bar__buttons weui-navigation-bar__buttons_goback">
          <view
            bindtap="back"
            class="weui-navigation-bar__btn_goback_wrapper"
            hover-class="weui-active"
            aria-role="button"
            aria-label="返回"
          >
            <view class="weui-navigation-bar__button weui-navigation-bar__btn_goback"></view>
          </view>
        </view>
      </block>
      <block wx:else>
        <slot name="left"></slot>
      </block>
    </view>

    <!-- 标题 -->
    <view class="weui-navigation-bar__center">
      <view wx:if="{{loading}}" class="weui-navigation-bar__loading" aria-role="alert"></view>
      <block wx:if="{{title}}">
        <text>{{title}}</text>
      </block>
      <block wx:else>
        <slot name="center"></slot>
      </block>
    </view>

    <!-- 右侧留空 -->
    <view class="weui-navigation-bar__right">
      <slot name="right"></slot>
    </view>
  </view>
</view>
