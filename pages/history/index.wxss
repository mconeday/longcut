/* P7 历史列表：说明行、左滑删除、缩略行、空态 */

.wrap {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  padding-top: 24rpx;
}

/* 说明行与右侧「清空」 */
.hintbar {
  height: 40rpx;
  padding: 0 40rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex: none;
}

.hint {
  font-size: 28rpx;
  line-height: 40rpx;
  color: var(--text-2);
}

.clear {
  font-size: 28rpx;
  color: #C2362B;
  padding: 8rpx 0 8rpx 40rpx;
}

.clear.off {
  color: #7A7568;
}

.list {
  flex: 1;
  overflow: hidden;
  padding-bottom: 40rpx;
}

/* 行 76px：主行左滑露出删除按钮 */
.row {
  position: relative;
  height: 152rpx;
  overflow: hidden;
}

.row+.row .row-main {
  border-top: 1px solid #E8E5DE;
}

.row-del {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 160rpx;
  background: #C2362B;
  color: #fff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.row-main {
  position: relative;
  z-index: 1;
  height: 152rpx;
  box-sizing: border-box;
  padding: 0 40rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: var(--bg, var(--page-bg-top));
  transition: transform 180ms cubic-bezier(.2, .8, .2, 1);
}

.row-main.open {
  transition: none;
}

/* 拖动中不做过渡，跟手 */
/* 纸形缩略 40×56px，无封面时画默认图标 */
.paper-icon {
  flex: none;
  width: 80rpx;
  height: 112rpx;
  border: 2rpx solid var(--line);
  border-radius: 6rpx;
  background: #FBFAF7;
}

.pdf-default {
  box-sizing: border-box;
}

/* 有封面：第 1 页缩略图 */
.paper-cover {
  flex: none;
  width: 80rpx;
  height: 112rpx;
  border: 2rpx solid var(--line);
  border-radius: 10rpx;
  background: #9e9d99;
  display: block;
}

.row-body {
  flex: 1;
  min-width: 0;
}

.fname {
  font-size: 32rpx;
  line-height: 44rpx;
  font-weight: 500;
  color: var(--text-1);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.meta {
  margin-top: 6rpx;
  font-size: 28rpx;
  line-height: 40rpx;
  color: var(--text-2);
  font-variant-numeric: tabular-nums;
}

.meta.gone {
  color: var(--danger-700, #96231A);
}

.row-a {
  flex: none;
  color: var(--text-3);
  font-size: 36rpx;
}

/* 空态：纸形图标 + 标题 + 说明 */
.empty {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding-bottom: 120rpx;
}

.paper-big {
  width: 88rpx;
  height: 112rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid var(--line);
  border-radius: 6rpx;
  background: #FBFAF7;
  position: relative;
}

.paper-big::after {
  content: '';
  position: absolute;
  left: 14rpx;
  right: 14rpx;
  top: 26rpx;
  height: 3rpx;
  background: var(--line);
  box-shadow: 0 18rpx 0 var(--line), 0 36rpx 0 var(--line);
}

.empty-t {
  font-size: 34rpx;
  line-height: 48rpx;
  font-weight: 600;
  color: var(--text-1);
}

.empty-s {
  font-size: 28rpx;
  line-height: 40rpx;
  color: var(--text-2);
  text-align: center;
}
/* 底部只留安全区内边距，无吸底按钮 */