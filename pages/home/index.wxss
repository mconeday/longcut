/* P1 首页：主视觉、隐私行、选图卡、已选缩略条、S1 半屏 */
.wrap { position: relative;}
.wrap > view, .wrap > block { position: relative; z-index: 1; }

/* 主视觉插画：左右通铺 */
.hero { width: 100%; margin: 0 auto 32rpx; }
.hero-illu {
  width: 100%; height: 380rpx;
  display: block;
}
/* 标题与副标 */
.hero-title {
  margin-top: 24rpx;
  font-size: 40rpx; line-height: 56rpx; font-weight: 600;
  letter-spacing: -0.5rpx;
  color: var(--brand-800);
  text-align: center;
}
.hero-sub {
  margin-top: 8rpx;
  font-size: 26rpx; line-height: 38rpx;
  color: var(--text-2);
  text-align: center;
}
/* 隐私行：淡绿底 + 细描边 */
.trust {
  display: flex; align-items: center; gap: 12rpx;
  width: var(--content-w); margin: 0 auto 32rpx;
  padding: 24rpx 28rpx; box-sizing: border-box;
  background: var(--brand-50);
  border: 1rpx solid var(--brand-100);
  border-radius: 20rpx;
  font-size: 26rpx; color: var(--text-2);
}
/* 主按钮水平居中 */
.wrap > .btn-main { margin: 0 auto; }
.dot { width: 14rpx; height: 14rpx; border-radius: 50%; background: var(--brand-500); }
.trust-t { flex: 1; }
.trust-a { color: var(--brand-700, #1B5335); padding: 12rpx 0 12rpx 24rpx; }
.center { text-align: center; margin-top: 24rpx; }
.hist {
  width: var(--content-w); margin: 32rpx auto 0;
  padding: 20rpx 0; text-align: center;
  font-size: 26rpx; color: var(--text-3);
}

/* 两个等重选图卡 */
.pickcards {
  width: var(--content-w); margin: 0 auto;
  display: flex; gap: 20rpx;
}
.pickcard {
  flex: 1; min-height: 320rpx;
  border: 1rpx solid var(--line); border-radius: 20rpx;
  box-sizing: border-box;
  background: var(--paper);
  box-shadow: 0 2rpx 8rpx rgba(28, 26, 23, 0.06);
  display: flex; flex-direction: column;
  align-items: center; justify-content: flex-start;
  padding: 20rpx 20rpx 28rpx;
}
.pickcard:active { background: var(--brand-50); border-color: var(--brand-200); }
/* 卡内插图与标题 */
.pc-img {
  width: 100%; height: 220rpx;
  border-radius: 14rpx;
  display: block;
}
.pc-tt { font-size: 32rpx; font-weight: 600; line-height: 44rpx; margin-top: 20rpx; text-align: center; }
.pc-note { margin-top: 20rpx; font-size: 25rpx; line-height: 36rpx; color: var(--text-3); text-align: center; }

/* 已选图卡 335×196 */
.pick-card {
  position: relative;
  width: var(--content-w);
  margin: 0 auto 32rpx;
  background: var(--brand-100);
  border: 1rpx solid var(--brand-200);
  border-radius: 20rpx;
  box-sizing: border-box;
  padding: 24rpx 0 28rpx;
}
.pick-head {
  display: flex; align-items: baseline; justify-content: space-between;
  padding: 0 28rpx 20rpx;
}
.pick-count { font-size: 28rpx; color: var(--text-2); }
.pick-hint { font-size: 24rpx; color: var(--text-3); }
.pick-strip { width: 100%; box-sizing: border-box; }
.pick-row { display: inline-flex; align-items: flex-start; padding: 0 28rpx; }
/* 满 4 张时收掉右内边距，避免徽章被裁 */
.pick-row.full { padding-right: 0; }

.pick-thumb {
  position: relative;
  width: 144rpx; height: 192rpx; flex: none;
  margin-right: 16rpx;
  border-radius: 10rpx; overflow: hidden;
  background: var(--n-50);
  border: 1rpx solid var(--line);
  box-shadow: 0 2rpx 8rpx rgba(28,26,23,.08);
  transition: transform 120ms ease-out, box-shadow 120ms ease-out;
}
/* 拖动时抬高投影 */
.pick-thumb.lift { z-index: 5; box-shadow: 0 12rpx 28rpx rgba(28,26,23,.28); }
.pick-img { width: 100%; height: 100%; display: block; }
/* 右下角序号 */
.pick-no {
  position: absolute; right: 6rpx; bottom: 6rpx;
  min-width: 32rpx; height: 32rpx; line-height: 32rpx; padding: 0 8rpx;
  border-radius: 16rpx; background: rgba(28,26,23,.55);
  color: #fff; font-size: 22rpx; text-align: center;
}
/* 删除徽章：视觉 20px，热区 44px */
.pick-del {
  position: absolute; right: 0; top: 0;
  width: 88rpx; height: 88rpx;
  display: flex; align-items: flex-start; justify-content: flex-end;
  padding: 6rpx; box-sizing: border-box;
}
.pick-del-ic {
  width: 40rpx; height: 40rpx; border-radius: 50%;
  background: rgba(255,255,255,.95);
  box-shadow: 0 2rpx 8rpx rgba(28,26,23,.3);
  font-size: 30rpx; line-height: 38rpx; text-align: center; color: #1C1A17;
}
.pick-add {
  width: 144rpx; height: 192rpx; flex: none;
  border: 2rpx dashed var(--brand-300); border-radius: 10rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 48rpx; color: var(--brand-600);
}

/* 加载态：槽位转圈、按钮白圈 */
@keyframes home-spin { to { transform: rotate(360deg); } }
.pick-thumb.scanning {
  display: flex; align-items: center; justify-content: center;
  background: var(--brand-50);
}
.pick-spin {
  width: 44rpx; height: 44rpx; border-radius: 50%;
  border: 5rpx solid var(--brand-100);
  border-top-color: var(--brand-500);
  animation: home-spin .8s linear infinite;
}
.btn-spin {
  width: 30rpx; height: 30rpx; border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,.35);
  border-top-color: #fff;
  animation: home-spin .8s linear infinite;
  margin-right: 14rpx;
}

/* S1 半屏 */
.mask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(28,26,23,.42);
  display: flex; align-items: flex-end;
  z-index: 20;
}
.sheet {
  width: 100%; box-sizing: border-box;
  background: var(--paper);
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
}
.sheet-title { font-size: 34rpx; line-height: 48rpx; font-weight: 600; color: var(--text-1); }
.sheet-sub { margin-top: 12rpx; font-size: 30rpx; line-height: 44rpx; color: var(--text-1); }
.sheet-btn { margin-top: 40rpx; }
.btn-ghost {
  width: var(--content-w); height: 88rpx; margin: 16rpx auto 0;
  display: flex; align-items: center; justify-content: center;
  background: var(--paper); border: 1rpx solid var(--line); border-radius: 20rpx;
  font-size: 30rpx; color: var(--text-1); box-sizing: border-box;
}
.btn-text {
  height: 88rpx; line-height: 88rpx; text-align: center;
  font-size: 30rpx; color: var(--text-2);
}
.step { display: flex; gap: 20rpx; margin-top: 28rpx; }
.step-n {
  flex: none; width: 40rpx; height: 40rpx; border-radius: 50%;
  background: var(--brand-50); color: var(--brand-700);
  font-size: 24rpx; line-height: 40rpx; text-align: center;
}
.step-t { flex: 1; font-size: 28rpx; line-height: 42rpx; color: var(--text-1); }
